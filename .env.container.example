# Copy to .env.container and export before running compose if desired

# Choose one DB backend for Saiku/PDI runtime values: mysql or postgresql
STACK_DB_TYPE=mysql
STACK_DB_NAME=ecommerce_bi
STACK_DB_USER=bi_user
STACK_DB_PASSWORD=bi_password

# DB ports on host
STACK_MYSQL_PORT=3306
STACK_POSTGRES_PORT=5432

# Tool ports on host
STACK_SAIKU_PORT=8080
STACK_PRD_WEB_PORT=6080
STACK_PRD_VNC_PORT=5900

# Root password for MySQL service
MYSQL_ROOT_PASSWORD=root_password

# Optional: pin tool versions / download URLs
PDI_VERSION=9.4.0.0-343
SAIKU_VERSION=3.17
PRD_VERSION=10.2.0.0-218

# Optional: override download sources (works for Docker and Podman builds)
# PDI_DOWNLOAD_URL=https://downloads.sourceforge.net/project/pentaho/Data%20Integration/9.4/pdi-ce-9.4.0.0-343.zip
# SAIKU_DOWNLOAD_URL=https://downloads.sourceforge.net/project/saiku/saiku-server/saiku-server-3.17.zip
# PRD_DOWNLOAD_URL=https://downloads.sourceforge.net/project/pentaho/Report%20Designer/10.2/prd-ce-10.2.0.0-218.zip
# MYSQL_JDBC_URL=https://repo1.maven.org/maven2/com/mysql/mysql-connector-j/8.4.0/mysql-connector-j-8.4.0.jar
# POSTGRES_JDBC_URL=https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.4/postgresql-42.7.4.jar
