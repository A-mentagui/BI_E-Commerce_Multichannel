  <step>
    <name>Derive Time Attributes</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Time Dimensions</jsScript_name>
        <jsScript_script>// 1. Ensure we have a valid JS Date object
var fulldate = (OrderDate != null) ? new Date(OrderDate.getTime()) : null;

if (fulldate != null) {
    var createdat = new Date();
    var year = fulldate.getFullYear();
    var month = fulldate.getMonth() + 1;
    var quarter = Math.floor((month - 1) / 3) + 1;
    var dayofmonth = fulldate.getDate();
    var dow0 = fulldate.getDay();
    var dayofweek = ((dow0 + 6) % 7) + 1;

    var monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    var dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
    var monthname = monthNames[month - 1];
    var dayname = dayNames[dow0];

    var startOfYear = new Date(year, 0, 1);
    var diffDays = Math.floor((fulldate.getTime() - startOfYear.getTime()) / 86400000);
    var weekofyear = Math.floor((diffDays + startOfYear.getDay() + 1) / 7) + 1;

    var season = 'Winter';
    if (month >= 3 &amp;&amp; month &lt;= 5) season = 'Spring';
    if (month >= 6 &amp;&amp; month &lt;= 8) season = 'Summer';
    if (month >= 9 &amp;&amp; month &lt;= 11) season = 'Autumn';

    var isweekend = (dow0 == 0 || dow0 == 6);
    var isholiday = false;

    var timekey = (year * 10000) + (month * 100) + dayofmonth;
}</jsScript_script>
      </jsScript>
    </jsScripts>
