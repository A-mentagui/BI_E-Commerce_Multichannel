# Ignore Python cache files
__pycache__/
*.py[cod]

# Ignore data files
/data/raw/
/data/processed/
/data/warehouse/

# Ignore logs
*.log
/logs/

# Ignore temporary files
*.tmp
*.temp
*.bak
*.swp

# Ignore database dumps
*.db

# Keep SQL schema files tracked
# *.sql is NOT ignored — sql/ folder is versioned

# Ignore IDE-specific files
.vscode/
.idea/
*.iml

# Ignore Docker build artifacts
docker/*.tar
docker/*.zip

# Ignore visualization exports
/visualization/**/*.pdf
/visualization/**/*.xlsx
/visualization/**/*.html

# Ignore environment files (but keep examples)
.env
.env.local
.env.container
!.env.example
!.env.container.example

# Ignore node_modules (if applicable)
node_modules/

# Ignore compiled binaries
*.exe
*.dll
*.so
*.dylib
*.out
*.o

# Ignore other system files
.DS_Store
Thumbs.db

*.zip