# Ignore Python cache files
__pycache__/
*.py[cod]

# Ignore data files
/data/raw/
/data/processed/
/data/warehouse/

# Ignore logs
*.log
/logs/

# Ignore temporary files
*.tmp
*.temp
*.bak
*.swp

# Ignore database dumps
*.sql
*.db

# Ignore IDE-specific files
.vscode/
.idea/
*.iml

# Ignore Docker build artifacts
docker/*.tar
docker/*.zip

# Ignore visualization exports
/visualization/**/*.pdf
/visualization/**/*.xlsx
/visualization/**/*.html

# Ignore environment files
.env
.env.*

# Ignore node_modules (if applicable)
node_modules/

# Ignore compiled binaries
*.exe
*.dll
*.so
*.dylib
*.out
*.o

# Ignore other system files
.DS_Store
Thumbs.db

