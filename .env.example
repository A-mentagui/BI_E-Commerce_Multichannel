# Environment Configuration - BI E-Commerce Project
# Copy this file to .env and update values for your environment

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MySQL Connection
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_bi
DB_USER=root
DB_PASSWORD=your_password_here
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://localhost:3306/ecommerce_bi

# Alternative: PostgreSQL
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ecommerce_bi
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_DRIVER=org.postgresql.Driver
# DB_URL=jdbc:postgresql://localhost:5432/ecommerce_bi

# Alternative: SQLite (for development)
# DB_DRIVER=org.sqlite.JDBC
# DB_URL=jdbc:sqlite:ecommerce_bi.db

# ============================================================================
# PENTAHO CONFIGURATION
# ============================================================================

# Pentaho Home Directory
PENTAHO_HOME=/opt/pentaho/data-integration
# For Windows
# PENTAHO_HOME=C:\pentaho\data-integration

# Pentaho Server (if using Pentaho Server)
PENTAHO_SERVER_URL=http://localhost:8080/pentaho
PENTAHO_SERVER_USER=admin
PENTAHO_SERVER_PASSWORD=password

# Java Configuration
JAVA_HOME=/usr/lib/jvm/java-11-openjdk
JAVA_OPTS=-Xmx4096m -Xms1024m

# ============================================================================
# MONDRIAN/OLAP CONFIGURATION
# ============================================================================

# Mondrian Server
MONDRIAN_SERVER=http://localhost:8080/mondrian
MONDRIAN_DRIVER=mondrian.olap4j.MondrianOlap4jDriver
MONDRIAN_JDBC_URL=jdbc:mondrian:Catalog=ecommerce_catalog.xml;Datasource=ecommerce_bi

# Saiku Analytics (Optional OLAP UI)
SAIKU_URL=http://localhost:8080/saiku
SAIKU_USER=admin
SAIKU_PASSWORD=password

# ============================================================================
# DATA PATHS
# ============================================================================

# Data directories
DATA_RAW_PATH=./data/raw/
DATA_PROCESSED_PATH=./data/processed/
DATA_WAREHOUSE_PATH=./data/warehouse/

# ETL Logs
ETL_LOG_PATH=./logs/etl/
ETL_ERROR_PATH=./logs/errors/

# Results
RESULTS_PATH=./results/

# ============================================================================
# ETL CONFIGURATION
# ============================================================================

# ETL Schedule (cron format)
ETL_SCHEDULE_DAILY=0 2 * * *
ETL_SCHEDULE_WEEKLY=0 1 ? * SUN

# ETL Parameters
ETL_BATCH_SIZE=5000
ETL_MAX_ERRORS=1000
ETL_ERROR_FILE_PATH=./logs/errors/
ETL_LOG_LEVEL=INFO
ETL_TIMEOUT_MINUTES=120

# Data Quality
DQC_MIN_ROWS=49000
DQC_MAX_ERRORS_PERCENT=1
DQC_EMAIL_ERRORS=true

# ============================================================================
# ANALYTICS CONFIGURATION
# ============================================================================

# Python Environment
PYTHON_PATH=/usr/bin/python3
# For Windows
# PYTHON_PATH=C:\Python39\python.exe

# Data Mining
CHURN_THRESHOLD_DAYS=180
RFM_QUARTILE=4
ASSOCIATION_MIN_SUPPORT=0.01
ASSOCIATION_MIN_CONFIDENCE=0.2
ASSOCIATION_MIN_LIFT=1.1

# ============================================================================
# EMAIL NOTIFICATIONS
# ============================================================================

# SMTP Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=bi-alerts@company.com
SMTP_TO=team@company.com
SMTP_ENABLED=false

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log Level
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARN, ERROR

# Log Retention (days)
LOG_RETENTION_DAYS=30

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Backup paths
BACKUP_PATH=./backups/
BACKUP_RETENTION_DAYS=90
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * 0

# ============================================================================
# PROXY CONFIGURATION (if needed)
# ============================================================================

# PROXY_HOST=proxy.company.com
# PROXY_PORT=8080
# PROXY_USER=user
# PROXY_PASSWORD=password

# ============================================================================
# DEVELOPMENT/PRODUCTION FLAGS
# ============================================================================

ENVIRONMENT=development
# Options: development, staging, production

DEBUG_MODE=true
TEST_MODE=false

# ============================================================================
# API CONFIGURATION (for future web services)
# ============================================================================

API_HOST=localhost
API_PORT=5000
API_DEBUG=true
API_LOG_LEVEL=INFO

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_TYPE=file
# Options: file, redis, memcached

# Redis (if using Redis cache)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# ============================================================================
# TIME ZONE & LOCALE
# ============================================================================

TIMEZONE=Europe/Paris
LOCALE=fr_FR.UTF-8
DATE_FORMAT=yyyy-MM-dd
TIME_FORMAT=HH:mm:ss

# ============================================================================
# MONITORING & ALERTING
# ============================================================================

MONITORING_ENABLED=true
ALERT_ON_ERROR=true
ALERT_ON_WARNING=false
METRICS_ENABLED=true

# ============================================================================
# SECURITY
# ============================================================================

SSL_ENABLED=false
SSL_KEYSTORE=/path/to/keystore.jks
SSL_KEYSTORE_PASSWORD=changeit
SSL_KEY_PASSWORD=changeit

# API TOKEN (for authentication)
API_TOKEN=your_secure_token_here

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_IDLE_TIME=300

# Thread Pool
THREAD_POOL_SIZE=4
THREAD_POOL_QUEUE_SIZE=100

# Memory Settings (MB)
HEAP_MIN=1024
HEAP_MAX=4096

# ============================================================================
# ARCHIVING CONFIGURATION
# ============================================================================

ARCHIVE_ENABLED=true
ARCHIVE_OLD_DAYS=365
ARCHIVE_PATH=./archive/

# ============================================================================
# NOTES
# ============================================================================

# 1. Copy this file: cp .env.example .env
# 2. Update values for your environment
# 3. Never commit actual .env file to version control
# 4. Add .env to .gitignore
# 5. For Pentaho, also set environment variables in:
#    - Linux: ~/.bashrc or ~/.bash_profile
#    - Windows: System Environment Variables
# 6. Test database connection after updating
# 7. Use different credentials for dev/test/prod
